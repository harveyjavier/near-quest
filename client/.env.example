# ---------------------------------------------------------------------------
# Fishing Idle Game MMO -- frontend build environment
# Copy to .env.local for development, or set in the CI/deploy environment.
# There are no secrets here: everything in a Vite VITE_* var ships to the
# browser in plain text.
# ---------------------------------------------------------------------------

# Where the Colyseus backend lives.
# Local development:  ws://127.0.0.1:2567
# Production:         wss://your-app.up.railway.app
# https:// and bare hostnames are accepted and upgraded to wss:// automatically.
VITE_SERVER_URL=ws://127.0.0.1:2567
