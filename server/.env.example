# ---------------------------------------------------------------------------
# Fishing Idle Game MMO -- backend environment
# Copy to .env for local development. NEVER commit a filled-in .env.
# ---------------------------------------------------------------------------

# Port the Colyseus + Express process binds to.
# Railway and Heroku inject PORT automatically -- do not set it there.
PORT=2567

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/fishing-idle
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/fishing-idle
# Leave blank for local development to use the in-memory store instead.
MONGO_URL=

# Refuse to boot without MONGO_URL. Set to false in production so a
# misconfigured deploy fails loudly instead of silently losing every player.
ALLOW_MEMORY_DB=true

# Browser origins allowed to reach this backend. Comma-separated.
# In production set this to your Firebase Hosting URL(s).
# Leave blank to allow any origin (development only).
CORS_ORIGIN=

# debug | info | warn | error
LOG_LEVEL=info

# Number of proxies in front of this server, so the rate limit sees the real
# client IP. 1 on Railway/Heroku. Leave empty when nothing sits in front:
# X-Forwarded-For is then client-controlled and must not be trusted.
TRUST_PROXY=

# NEAR wallet sign-in. testnet or mainnet; the client uses whatever the server sends.
# NEAR_RPC_URL defaults to https://rpc.<network>.near.org; use a dedicated provider
# in production. NEAR_ARCHIVAL_RPC_URL (default https://archival-rpc.<network>.near.org)
# is only asked for deposit transactions the main RPC no longer has.
# NEAR_AUTH_RECIPIENT appears in the wallet prompt and is part of every signature,
# so changing it invalidates sign-ins that are in progress.
NEAR_NETWORK=testnet
NEAR_RPC_URL=
NEAR_ARCHIVAL_RPC_URL=
NEAR_AUTH_RECIPIENT=robins-club

# USDC deposits. Setting a treasury account turns on-chain deposits on; players
# send USDC there and the server credits it once the transfer is final. The
# treasury must be registered for storage on the USDC contract first.
# NEAR_USDC_CONTRACT defaults to Circle's USDC for NEAR_NETWORK.
NEAR_TREASURY_ACCOUNT=
NEAR_USDC_CONTRACT=

# Fake deposits credit USDG for nothing. Local development only: ignored when a
# treasury is set and refused when NODE_ENV=production. Set to true locally if
# you want the Deposit button to work without a chain.
ALLOW_FAKE_DEPOSITS=
