# ---------------------------------------------------------------------------
# Fishing Idle Game MMO -- backend environment
# Copy to .env for local development. NEVER commit a filled-in .env.
# ---------------------------------------------------------------------------

# Port the Colyseus + Express process binds to.
# Railway and Heroku inject PORT automatically -- do not set it there.
PORT=2567

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/fishing-idle
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/fishing-idle
# Leave blank for local development to use the in-memory store instead.
MONGO_URL=

# Refuse to boot without MONGO_URL. Set to false in production so a
# misconfigured deploy fails loudly instead of silently losing every player.
ALLOW_MEMORY_DB=true

# Browser origins allowed to reach this backend. Comma-separated.
# In production set this to your Firebase Hosting URL(s).
# Leave blank to allow any origin (development only).
CORS_ORIGIN=

# debug | info | warn | error
LOG_LEVEL=info

# NEAR wallet sign-in. testnet or mainnet; the client uses whatever the server sends.
# NEAR_RPC_URL defaults to https://rpc.<network>.near.org.
# NEAR_AUTH_RECIPIENT appears in the wallet prompt and is part of every signature,
# so changing it invalidates sign-ins that are in progress.
NEAR_NETWORK=testnet
NEAR_RPC_URL=
NEAR_AUTH_RECIPIENT=robins-club
